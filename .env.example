# Web application configuration
WEB_APP_PORT=5000
WEB_WORKERS=8

# Application configuration
PROJECT_VERSION=3.1.3
MAX_CONTENT_LENGTH=3145728
MAX_PENDING_TIME=600
# Per-subprocess wall clock; defaults to MAX_PENDING_TIME/2 (min 60s) so
# analyzers that run two tools in sequence still fit the job timeout.
#SUBPROCESS_TIMEOUT=300
MAX_STORE_TIME=259200
# DANGER: 1 drops the whole database and stored results every time the stack
# starts (initdb runs on each `docker compose up`). Keep 0 unless you really
# want a throwaway instance.
CLEAR_AT_RESTART=0
SKIP_IHDR_FILL=0
# "Ask AI" result-page panel: the visitor's own API key, used by their own
# browser to call their own LLM provider. No key and no analyzer output passes
# through this server, so the panel costs the instance nothing. 0 removes it.
AI_PANEL_ENABLED=1
REMOVAL_MIN_AGE_SECONDS=300
CLEANUP_INTERVAL_SECONDS=900

# Ads are opt-in: leave both empty (the default) to serve no ads.txt and load
# no external script. Placement is left entirely to AdSense Auto ads, which
# the loader script below enables — the app itself never injects ad markup.
# If you monetize a self-hosted instance, use YOUR OWN AdSense publisher id:
#   GOOGLE_ADS_TXT="google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0"
#   CUSTOM_EXTERNAL_SCRIPT="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
GOOGLE_ADS_TXT=
CUSTOM_EXTERNAL_SCRIPT=

# Public base URL for canonical/sitemap/Open Graph absolute links
SITE_BASE_URL=

# MCP endpoint (docs/mcp.md). The `mcp` compose service exposes the analysis
# API to agent clients over Streamable HTTP on 127.0.0.1:5001/mcp. Nothing
# LLM-related runs on the server: no key, no model call, no agent loop.
#
# Every variable below is OPTIONAL — the value shown is the built-in default,
# so a stock `docker compose up` needs none of them. Uncomment to retune the
# quotas, which are enforced per client IP (the rightmost X-Forwarded-For hop)
# on the same Redis DB 1 as the website's own rate limiter.
#
# `analyze` is the only tool that spends worker CPU, so it carries both a
# per-IP quota and a ceiling shared by every client; it fails CLOSED if Redis
# is unreachable, while read tools fail open.
#MCP_LIMIT_ANALYZE=5 per minute; 30 per hour
#MCP_LIMIT_ANALYZE_GLOBAL=120 per hour
# download_extracted and get_layer_image.
#MCP_LIMIT_HEAVY=30 per minute
# get_status, wait_until_done, get_info, list_results, get_tool_output.
#MCP_LIMIT_READ=120 per minute
# Archives above this are not inlined as base64; the error carries the URL.
#MCP_MAX_DOWNLOAD_BYTES=2097152
# Browser-openable base for that URL. Falls back to SITE_BASE_URL.
#MCP_PUBLIC_BASE_URL=

# Flask configuration
FLASK_DEBUG=0

# Redis configuration. REDIS_PASSWORD is the one source of truth: compose.yml
# builds REDIS_URL/RATELIMIT_STORAGE_URI/RQ_DASHBOARD_REDIS_URL from it (and
# passes it to redis-server --requirepass) rather than reading pre-built URLs
# from here, so the password never needs editing in more than one place.
# Change this before exposing the stack beyond localhost.
REDIS_PASSWORD=changeme

# Database configuration
POSTGRES_DB=aperisolve
POSTGRES_USER=aperiuser
POSTGRES_PASSWORD=aperipass
DB_URI=postgresql://aperiuser:aperipass@postgres:5432/aperisolve

# Sentry configuration
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development
