# Web application configuration
WEB_APP_PORT=5000
WEB_WORKERS=8

# Application configuration
PROJECT_VERSION=3.1.3
MAX_CONTENT_LENGTH=3145728
MAX_PENDING_TIME=600
# Per-subprocess wall clock; defaults to MAX_PENDING_TIME/2 (min 60s) so
# analyzers that run two tools in sequence still fit the job timeout.
#SUBPROCESS_TIMEOUT=300
MAX_STORE_TIME=259200
# DANGER: 1 drops the whole database and stored results every time the stack
# starts (initdb runs on each `docker compose up`). Keep 0 unless you really
# want a throwaway instance.
CLEAR_AT_RESTART=0
SKIP_IHDR_FILL=0
REMOVAL_MIN_AGE_SECONDS=300
CLEANUP_INTERVAL_SECONDS=900

# Ads are opt-in: leave both empty (the default) to serve no ads.txt and load
# no external script. If you monetize a self-hosted instance, use YOUR OWN
# AdSense publisher id, e.g.:
#   GOOGLE_ADS_TXT="google.com, pub-XXXXXXXXXXXXXXXX, DIRECT, f08c47fec0942fa0"
#   CUSTOM_EXTERNAL_SCRIPT="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX"
GOOGLE_ADS_TXT=
CUSTOM_EXTERNAL_SCRIPT=

# Manual AdSense units (leave empty to disable; self-hosted default).
# CUSTOM_EXTERNAL_SCRIPT above loads the AdSense JS. ADSENSE_CLIENT is
# derived from its ?client=ca-pub-... query string when left empty, so
# usually only the per-placement slot ids below need setting.
ADSENSE_CLIENT=
ADSENSE_SLOT_INDEX=
ADSENSE_SLOT_RESULT=
# Wiki slots: set the two below for separate sidebar/in-article reporting,
# or just ADSENSE_SLOT_WIKI to use one unit for both placements.
ADSENSE_SLOT_WIKI=
ADSENSE_SLOT_WIKI_SIDEBAR=
ADSENSE_SLOT_WIKI_ARTICLE=

# Public base URL for canonical/sitemap/Open Graph absolute links
SITE_BASE_URL=

# Flask configuration
FLASK_DEBUG=0

# Redis configuration
REDIS_URL=redis://redis:6379/0
RQ_DASHBOARD_REDIS_URL=redis://redis:6379/0
RATELIMIT_STORAGE_URI=redis://redis:6379/1

# Database configuration
POSTGRES_DB=aperisolve
POSTGRES_USER=aperiuser
POSTGRES_PASSWORD=aperipass
DB_URI=postgresql://aperiuser:aperipass@postgres:5432/aperisolve

# Sentry configuration
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development
